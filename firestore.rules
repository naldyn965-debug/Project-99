rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // دالّتان مساعدتان (Helpers)
    function isAuth() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }

    // ── SOCIAL POSTS ──
    match /social_posts/{postId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.authorUid == request.auth.uid
        ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likesCount','likedBy','savedBy','sharesCount','commentsCount'])
      );
      allow delete: if isAuth()
        && resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth();
        allow update: if isAuth() && resource.data.authorUid == request.auth.uid;
        allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
      }
    }

    // ── SOCIAL FOLLOWS ──
    match /social_follows/{followId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.followerUid == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.followerUid == request.auth.uid;
    }

    // ── SOCIAL NOTIFICATIONS ──
    match /social_notifications/{notifId} {
      allow read, update, delete: if isAuth()
        && resource.data.toUid == request.auth.uid;
      allow create: if isAuth();
    }

    // ── FAVORITES ──
    match /favorites/{uid} {
      allow read, write: if isSelf(uid);
    }

    // ── ACADEMY NOTIFICATIONS ──
    match /academy_notifications/{notifId} {
      allow read: if (isAuth() && (
        resource.data.scope == 'broadcast' ||
        (resource.data.scope == 'user' && resource.data.userId == request.auth.uid)
      )) || isAdmin();
      
      allow update: if isAuth() && resource.data.scope == 'user'
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
                    
      allow update: if isAuth() && resource.data.scope == 'broadcast'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
                    && request.resource.data.readBy.hasAll(resource.data.readBy)
                    && request.resource.data.readBy.hasOnly(resource.data.readBy.concat([request.auth.uid]));
                    
      allow create, delete: if isAdmin();
    }

    // ── ACADEMY BROADCAST LOG ──
    match /academy_broadcast_log/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ── USER SUBCOLLECTIONS ──
    match /users/{uid}/{subcollection}/{docId} {
      allow read, write: if isSelf(uid);
    }

    // ── DEFAULT CATCH-ALL (Deny all other access) ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
