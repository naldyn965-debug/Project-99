+/* ── Splash v2 ─────────────────────────────────────────────────────
+   خلفية بيضا بنفس أبيض الموقع (--bg) + لوجو النبتة بيتـرسم + اسم Nabtex
+   بحروف بتظهر بالتتابع + خروج بستارة بتتسحب لفوق بحافة منحنية.
+   - الخلفية فضلت على ::before (إصلاح Safari فوق متحفظ عليه زي ما هو).
+   - مدة الخروج 560ms أقل من مؤقت الحذف (600ms) في App._loader()، فمفيش JS اتغيّر.
+   - الخط: Cormorant Garamond 600 مقصوص على حروف Nabtex بس (~1.8KB) ومدمج،
+     عشان الاسم يظهر من أول فريم من غير FOUT. لو اتمسح بيرجع لـ Google Fonts.
+   - الدارك مود: #ldr بياخد data-dark من سكريبت صغير بعد الـ HTML. */
+@font-face{font-family:'NbxMark';font-style:normal;font-weight:600;font-display:block;src:url(data:font/woff2;base64,) format('woff2')}
+#ldr{--ld-hi:#fff;--ld-curve:min(16vh,150px)}
+#ldr[data-dark]{--ld-hi:#14251a}
+#ldr::before{content:'';position:absolute;inset:0 0 calc(var(--ld-curve) * -1) 0;z-index:-1;background:radial-gradient(85% 62% at 50% 44%,var(--ld-hi) 0%,var(--bg) 58%,var(--bg2) 100%);border-radius:0 0 50% 50% / 0 0 var(--ld-curve) var(--ld-curve)}
+#ldr .l-stage{display:flex;flex-direction:column;align-items:center;margin-top:-3vh}
+#ldr .l-logo{display:flex;align-items:center;direction:ltr;gap:.24em;font-size:clamp(40px,12vw,56px);line-height:1}
+#ldr .l-mark{width:1.2em;height:1.2em;overflow:visible;fill:none;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 .03em .07em rgba(27,107,58,.22));animation:ldrMark 1.1s var(--ease-out) both}
+#ldr .l-mark path{stroke-dasharray:1 2;stroke-dashoffset:1.02;animation:ldrDraw .5s var(--ease-out) forwards}
+#ldr .l-mark .a{animation-delay:.1s;animation-duration:.4s}
+#ldr .l-mark .b{animation-delay:.34s}
+#ldr .l-mark .c{animation-delay:.5s}
+#ldr[data-dark] .l-mark stop:first-child{stop-color:#6fd68f}
+#ldr[data-dark] .l-mark stop:last-child{stop-color:#2f9d5a}
+#ldr .l-word{display:flex;font-family:'NbxMark','Cormorant Garamond',serif;font-weight:600;letter-spacing:.012em;color:var(--ink);padding-bottom:.06em}
+#ldr .l-word span{display:inline-block;opacity:0;transform:translateY(.3em);filter:blur(.12em);animation:ldrLetter .6s var(--ease-out) forwards;animation-delay:calc(.34s + var(--i) * .055s)}
+#ldr .l-word span:first-child{color:var(--brand)}
+#ldr[data-dark] .l-word span:first-child{color:var(--brand-xl)}
+#ldr .l-tag{margin-top:clamp(14px,3vh,22px);font-family:var(--f-ui);font-size:13px;font-weight:500;color:var(--slate);letter-spacing:.02em;opacity:0;transform:translateY(8px);animation:ldrTag .6s .8s var(--ease-out) forwards}
+#ldr .l-line{position:relative;width:min(200px,52vw);height:2px;margin-top:clamp(20px,4vh,30px);border-radius:2px;background:var(--line2);overflow:hidden;opacity:0;animation:ldrFade .4s .5s forwards}
+#ldr .l-line::after{content:'';position:absolute;inset:0;border-radius:inherit;background:linear-gradient(90deg,var(--brand-xl),var(--gold-l));transform:scaleX(0);animation:ldrFill 1.4s .55s var(--ease-out) forwards,ldrGlow 1.6s 2s ease-in-out infinite}
+#ldr.out{pointer-events:none}
+#ldr.out::before{animation:ldrCurtain .56s cubic-bezier(.76,0,.24,1) forwards}
+#ldr.out .l-stage{animation:ldrStageOut .32s cubic-bezier(.5,0,.75,0) forwards}
+@keyframes ldrDraw{to{stroke-dashoffset:0}}
+@keyframes ldrMark{from{transform:scale(.9)}to{transform:none}}
+@keyframes ldrLetter{to{opacity:1;transform:none;filter:none}}
+@keyframes ldrTag{to{opacity:.82;transform:none}}
+@keyframes ldrFade{to{opacity:1}}
+@keyframes ldrFill{to{transform:scaleX(1)}}
+@keyframes ldrGlow{0%,100%{opacity:1}50%{opacity:.55}}
+@keyframes ldrCurtain{to{transform:translateY(-100%)}}
+@keyframes ldrStageOut{to{opacity:0;transform:translateY(-5vh) scale(1.04);filter:blur(4px)}}
+@keyframes ldrOutFade{to{opacity:0}}
+@media (prefers-reduced-motion:reduce){
+  #ldr .l-mark,#ldr .l-mark path,#ldr .l-word span,#ldr .l-tag,#ldr .l-line,#ldr .l-line::after{animation:none!important}
+  #ldr .l-mark path{stroke-dashoffset:0}
+  #ldr .l-word span{opacity:1;transform:none;filter:none}
+  #ldr .l-tag{opacity:.82;transform:none}
+  #ldr .l-line{opacity:1}
+  #ldr .l-line::after{transform:none}
+  #ldr.out::before{animation:ldrOutFade .3s forwards!important}
+  #ldr.out .l-stage{animation:ldrOutFade .2s forwards!important}
+}
 
