+<script>
+/* Auth UI only — password visibility toggle.
+   The submit handlers (hLogin / hReg / hResetPassword) find the fields with input[type="password"],
+   so every field is switched back to "password" in the capture phase, before any submit handler runs. */
+function nbTogglePw(btn){
+  var inp = btn.parentNode.querySelector('input');
+  if (!inp) return;
+  var s = inp.selectionStart, e = inp.selectionEnd, show = inp.type === 'password';
+  inp.type = show ? 'text' : 'password';
+  btn.setAttribute('aria-pressed', show ? 'true' : 'false');
+  btn.setAttribute('aria-label', show ? 'إخفاء كلمة المرور' : 'إظهار كلمة المرور');
+  if (document.activeElement === inp) { try { inp.setSelectionRange(s, e); } catch (_) {} }
+}
+function nbMaskPw() {
+  document.querySelectorAll('#auth-bg .fi-eye[aria-pressed="true"]').forEach(nbTogglePw);
+}
+(function () {
+  var bg = document.getElementById('auth-bg');
+  if (!bg) return;
+  bg.addEventListener('submit', nbMaskPw, true);
+  new MutationObserver(function () { if (!bg.classList.contains('on')) nbMaskPw(); })
+    .observe(bg, { attributes: true, attributeFilter: ['class'] });
+})();
+</script>
 
